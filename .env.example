# Public site origin. Manually configure .env.local; never commit private values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Generate independently of the backend JWT signing key. Never use NEXT_PUBLIC_.
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Required server-only address inside the shared Compose network.
BACKEND_API_URL=http://backend:8000/api/v1
# Optional request timeout in milliseconds, from 100 to 15000 (default 5000).
BACKEND_API_TIMEOUT_MS=5000
# No backend, database, Redis, or R2 credentials belong in the frontend.
# Let Next.js manage NODE_ENV through its commands.
